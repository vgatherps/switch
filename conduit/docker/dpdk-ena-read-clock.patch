+/* The device PTP hardware clock (PHC), ns. */
+static int ena_read_clock(struct rte_eth_dev *dev, uint64_t *clock)
+{
+	struct ena_adapter *adapter = dev->data->dev_private;
+
+	if (!adapter->ena_dev.phc.active)
+		return -ENOTSUP;
+
+	return ena_com_phc_get_timestamp(&adapter->ena_dev, clock);
+}
