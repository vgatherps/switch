+/* Activates the PHC when the device has one. On failure it stays inactive
+ * and read_clock returns -ENOTSUP.
+ */
+static void ena_phc_setup(struct ena_com_dev *ena_dev)
+{
+	int rc;
+
+	if (!ena_com_phc_supported(ena_dev))
+		return;
+
+	rc = ena_com_phc_init(ena_dev);
+	if (rc) {
+		PMD_DRV_LOG_LINE(ERR, "Failed to init PHC, rc: %d", rc);
+		return;
+	}
+
+	rc = ena_com_phc_config(ena_dev);
+	if (rc) {
+		PMD_DRV_LOG_LINE(ERR, "Failed to config PHC, rc: %d", rc);
+		ena_com_phc_destroy(ena_dev);
+	}
+}
