From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: vgatherps <vgatherps@gmail.com>
Subject: [PATCH] tls13: oversized record gets record_overflow before decryption

RFC 8446 §5.2: a TLS 1.3 record whose ciphertext exceeds 2^14 + 256
bytes MUST terminate the connection with a record_overflow alert. rustls
only rejected such a record after decrypting it (the plaintext length
check in `into_tls13_unpadded_message`); one that fails to decrypt got
bad_record_mac. Check the ciphertext length before decryption once
TLS 1.3 is negotiated.
---
 rustls/src/conn.rs | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/rustls/src/conn.rs b/rustls/src/conn.rs
--- a/rustls/src/conn.rs
+++ b/rustls/src/conn.rs
@@ -14,6 +14,7 @@
 use crate::msgs::deframer::DeframerIter;
 use crate::msgs::deframer::buffers::{BufferProgress, DeframerVecBuffer, Delocator, Locator};
 use crate::msgs::deframer::handshake::HandshakeDeframer;
+use crate::msgs::fragmenter::MAX_FRAGMENT_LEN;
 use crate::msgs::handshake::Random;
 use crate::msgs::message::{InboundPlainMessage, Message, MessagePayload};
 use crate::record_layer::Decrypted;
@@ -1026,6 +1027,12 @@
                     break (message.into_plain_message(), iter.bytes_consumed());
                 }
 
+                // RFC 8446 §5.2: a TLS 1.3 record longer than 2^14 + 256 bytes is fatal, with
+                // a record_overflow alert, whether or not it would decrypt.
+                if version_is_tls13 && message.payload.len() > MAX_FRAGMENT_LEN + 256 {
+                    return Err(self.handle_deframe_error(Error::PeerSentOversizedRecord, state));
+                }
+
                 let message = match self
                     .common_state
                     .record_layer
