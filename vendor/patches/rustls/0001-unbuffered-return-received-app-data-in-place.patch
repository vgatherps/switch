+/// Runs `client` until it blocks; returns whether its handshake is complete.
+fn client_handshake_step(
+    client: &mut UnbufferedClientConnection,
+    incoming: &mut Buffer,
+    outgoing: &mut Buffer,
+) -> bool {
+    loop {
+        let UnbufferedStatus { discard, state } = client.process_tls_records(incoming.filled());
+        let done = match state.unwrap() {
+            ConnectionState::EncodeTlsData(mut etd) => {
+                encode(&mut etd, outgoing);
+                None
+            }
+            ConnectionState::TransmitTlsData(ttd) => {
+                ttd.done();
+                None
+            }
+            ConnectionState::BlockedHandshake => Some(false),
+            ConnectionState::WriteTraffic(_) => Some(true),
+            st => panic!("unexpected client state {st:?}"),
+        };
+        incoming.discard(discard);
+        if let Some(done) = done {
+            return done;
+        }
+    }
+}
+
+/// Runs `server` until it blocks, sending `app_data` as soon as it may.
+fn server_handshake_step(
+    server: &mut UnbufferedServerConnection,
+    incoming: &mut Buffer,
+    outgoing: &mut Buffer,
+    mut app_data: Option<&[u8]>,
+) {
+    loop {
+        let UnbufferedStatus { discard, state } = server.process_tls_records(incoming.filled());
+        let blocked = match state.unwrap() {
+            ConnectionState::EncodeTlsData(mut etd) => {
+                encode(&mut etd, outgoing);
+                false
+            }
+            ConnectionState::TransmitTlsData(mut ttd) => {
+                if let Some(mut wt) = ttd.may_encrypt_app_data() {
+                    if let Some(app_data) = app_data.take() {
+                        encrypt(&mut wt, app_data, outgoing);
+                    }
+                }
+                ttd.done();
+                false
+            }
+            ConnectionState::BlockedHandshake => true,
+            ConnectionState::WriteTraffic(mut wt) => {
+                if let Some(app_data) = app_data.take() {
+                    encrypt(&mut wt, app_data, outgoing);
+                }
+                true
+            }
+            st => panic!("unexpected server state {st:?}"),
+        };
+        incoming.discard(discard);
+        if blocked {
+            assert!(app_data.is_none());
+            return;
+        }
+    }
+}
+
+fn encode<Data>(state: &mut EncodeTlsData<'_, Data>, outgoing: &mut Buffer) {
+    write_with_buffer_size_checks(
+        |out_buf| state.encode(out_buf),
+        |e| match e {
+            EncodeError::InsufficientSize(ise) => ise,
+            _ => unreachable!(),
+        },
+        outgoing,
+    );
+}
