+/// Processes `buf`, which ends in an app-data record carrying `expected`, dropping that record
+/// unread the first time; returns the `UnbufferedStatus::discard` and `AppDataRecord::discard`
+/// of the call that read it, both already discarded from `buf`.
+fn read_after_dropping_unread(
+    client: &mut UnbufferedClientConnection,
+    buf: &mut Buffer,
+    expected: &[u8],
+) -> (usize, usize) {
+    let (_, discard) = read_traffic(client.process_tls_records(buf.filled()), |rt| {
+        assert_eq!(rt.peek_len(), NonZeroUsize::new(expected.len()))
+    });
+    buf.discard(discard);
+
+    let ((data, record_discard), no_discard) =
+        read_traffic(client.process_tls_records(buf.filled()), |mut rt| {
+            let record = rt.next_record().unwrap().unwrap();
+            (record.payload.to_vec(), record.discard)
+        });
+    assert_eq!(no_discard, 0);
+    assert_eq!(data, expected);
+    buf.discard(record_discard);
+    (discard, record_discard)
+}
