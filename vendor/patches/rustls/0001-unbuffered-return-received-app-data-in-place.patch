+#[test]
+fn read_traffic_payload_is_decrypted_in_place() {
+    for version in [&rustls::version::TLS12, &rustls::version::TLS13] {
+        let mut outcome = handshake(version);
+        let mut client = outcome.client.take().unwrap();
+        let mut server = outcome.server.take().unwrap();
+
+        let mut buf = Buffer::default();
+        write_traffic(client.process_tls_records(&mut []), |mut wt| {
+            encrypt(&mut wt, b"hello", &mut buf);
+            encrypt(&mut wt, b"world", &mut buf);
+        });
+        let record_len = buf.used / 2;
+
+        for expected in [b"hello", b"world"] {
+            let ((payload, record_discard), discard) =
+                read_traffic(server.process_tls_records(buf.filled()), |mut rt| {
+                    let record = rt.next_record().unwrap().unwrap();
+                    assert_eq!(record.payload, expected);
+                    record.payload.fill(b'x');
+                    (record.payload.as_ptr_range(), record.discard)
+                });
+            assert_eq!(discard, 0);
+            assert_eq!(record_discard, record_len);
+
+            // the payload is the record's own bytes at the front of `buf`
+            let offset = payload.start as usize - buf.filled().as_ptr() as usize;
+            assert!(offset + expected.len() <= record_len);
+            if version.version == rustls::ProtocolVersion::TLSv1_3 {
+                assert_eq!(offset, 5);
+            }
+            assert_eq!(&buf.filled()[offset..offset + expected.len()], b"xxxxx");
+
+            buf.discard(record_discard);
+        }
+
+        assert_eq!(buf.used, 0);
+        write_traffic(server.process_tls_records(buf.filled()), |_| ());
+    }
+}
+
+#[test]
+fn read_traffic_unread_record_is_not_decrypted_again() {
+    let mut outcome = handshake(&rustls::version::TLS13);
+    let mut client = outcome.client.take().unwrap();
+    let mut server = outcome.server.take().unwrap();
+
+    let mut buf = Buffer::default();
+    write_traffic(client.process_tls_records(&mut []), |mut wt| {
+        encrypt(&mut wt, b"hello", &mut buf)
+    });
+    let record_len = buf.used;
+
+    // drop the record unread
+    let (_, discard) = read_traffic(server.process_tls_records(buf.filled()), |rt| {
+        assert_eq!(rt.peek_len(), NonZeroUsize::new(5))
+    });
+    assert_eq!(discard, 0);
+    assert_eq!(&buf.filled()[5..10], b"hello");
+
+    // destroy the tag: the record cannot be authenticated again
+    buf.filled()[10..].fill(0);
+
+    let ((data, record_discard), discard) =
+        read_traffic(server.process_tls_records(buf.filled()), |mut rt| {
+            let record = rt.next_record().unwrap().unwrap();
+            (record.payload.to_vec(), record.discard)
+        });
+    assert_eq!(discard, 0);
+    assert_eq!(record_discard, record_len);
+    assert_eq!(data, b"hello");
+
+    buf.discard(record_discard);
+    write_traffic(server.process_tls_records(buf.filled()), |_| ());
+}
+
+#[test]
+fn read_traffic_unread_record_after_key_update() {
+    let mut outcome = handshake(&rustls::version::TLS13);
+    let mut client = outcome.client.take().unwrap();
+    let mut server = outcome.server.take().unwrap();
+
+    let mut buf = Buffer::default();
+    write_traffic(server.process_tls_records(&mut []), |wt| {
+        wt.refresh_traffic_keys().unwrap()
+    });
+    let (key_update, _) = encode_tls_data(server.process_tls_records(&mut []));
+    buf.append(&key_update);
+    confirm_transmit_tls_data(server.process_tls_records(&mut []));
+    write_traffic(server.process_tls_records(&mut []), |mut wt| {
+        encrypt(&mut wt, b"hello", &mut buf)
+    });
+    let record_len = buf.used - key_update.len();
+
+    let (discard, record_discard) = read_after_dropping_unread(&mut client, &mut buf, b"hello");
+    assert_eq!(discard, key_update.len());
+    assert_eq!(record_discard, record_len);
+    assert_eq!(buf.used, 0);
+
+    // the client replies to the key update ahead of its data, under the new keys
+    let mut reply = Buffer::default();
+    write_traffic(client.process_tls_records(&mut []), |mut wt| {
+        encrypt(&mut wt, b"bye", &mut reply)
+    });
+    let ((data, record_discard), discard) =
+        read_traffic(server.process_tls_records(reply.filled()), |mut rt| {
+            let record = rt.next_record().unwrap().unwrap();
+            (record.payload.to_vec(), record.discard)
+        });
+    assert!(discard > 0);
+    assert_eq!(discard + record_discard, reply.used);
+    assert_eq!(data, b"bye");
+}
