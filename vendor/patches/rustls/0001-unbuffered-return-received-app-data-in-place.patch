+#[test]
+fn read_traffic_unread_record_after_tls12_handshake() {
+    let (mut client, mut server) = make_connection_pair(&rustls::version::TLS12);
+    let mut to_client = Buffer::default();
+    let mut to_server = Buffer::default();
+
+    assert!(!client_handshake_step(
+        &mut client,
+        &mut to_client,
+        &mut to_server
+    ));
+    server_handshake_step(&mut server, &mut to_server, &mut to_client, None);
+    assert!(!client_handshake_step(
+        &mut client,
+        &mut to_client,
+        &mut to_server
+    ));
+    // the server's final flight carries app data behind its Finished message
+    server_handshake_step(&mut server, &mut to_server, &mut to_client, Some(b"hello"));
+    assert_eq!(to_server.used, 0);
+
+    let total = to_client.used;
+    let (discard, record_discard) =
+        read_after_dropping_unread(&mut client, &mut to_client, b"hello");
+    assert!(discard > 0);
+    assert_eq!(discard + record_discard, total);
+    assert_eq!(to_client.used, 0);
+    assert!(!client.is_handshaking());
+    write_traffic(client.process_tls_records(&mut []), |_| ());
+}
