+#[test]
+fn read_traffic_unread_record_before_alert() {
+    for version in [&rustls::version::TLS12, &rustls::version::TLS13] {
+        for fatal in [false, true] {
+            let mut outcome = handshake(version);
+            let mut client = outcome.client.take().unwrap();
+            let mut server = outcome.server.take().unwrap();
+
+            let mut buf = Buffer::default();
+            let hello_len = write_traffic(server.process_tls_records(&mut []), |mut wt| {
+                encrypt(&mut wt, b"hello", &mut buf);
+                let hello_len = buf.used;
+                if !fatal {
+                    queue_close_notify(&mut wt, &mut buf);
+                }
+                hello_len
+            });
+            if fatal {
+                let mut junk = [0xff; 5];
+                let UnbufferedStatus { state, .. } = server.process_tls_records(&mut junk);
+                assert!(state.is_err());
+                let (alert, _) = encode_tls_data(server.process_tls_records(&mut []));
+                buf.append(&alert);
+            }
+            let alert_len = buf.used - hello_len;
+
+            let (discard, record_discard) =
+                read_after_dropping_unread(&mut client, &mut buf, b"hello");
+            assert_eq!(discard, 0);
+            assert_eq!(record_discard, hello_len);
+            assert_eq!(buf.used, alert_len);
+
+            if fatal {
+                let UnbufferedStatus { discard, state } = client.process_tls_records(buf.filled());
+                assert_eq!(discard, alert_len);
+                assert_eq!(
+                    state.unwrap_err(),
+                    Error::AlertReceived(AlertDescription::DecodeError)
+                );
+            } else {
+                assert_eq!(
+                    peer_closed(client.process_tls_records(buf.filled())),
+                    alert_len
+                );
+            }
+        }
+    }
+}
